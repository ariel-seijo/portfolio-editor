---

<section id="portfolio" class="work">
  <div class="container-portfolio">
    <h2 class="section-title">Trabajos realizados</h2>

    <!-- ── Tabs ── -->
    <div class="work-tabs" role="tablist" aria-label="Categorías de trabajos">
      <button type="button" class="work-tab is-active" role="tab" aria-selected="true" data-tab="videos">
        Videos largos
      </button>
      <button type="button" class="work-tab" role="tab" aria-selected="false" data-tab="shorts">
        Shorts
      </button>
      <button type="button" class="work-tab" role="tab" aria-selected="false" data-tab="thumbs">
        Miniaturas
      </button>
    </div>

    <div class="work-panels">
      <!-- ── Videos largos ── -->
      <div class="work-panel" data-panel="videos">
        <div class="work-filters" role="group" aria-label="Filtrar videos largos por juego">
          {
            filters.videos.map((f, i) => (
              <button type="button" class="work-filter" data-filter={f} aria-pressed="false">
                <span class="work-filter-number">{String(i + 1).padStart(2, "0")}</span>
                {filterLabels[f]}
              </button>
            ))
          }
        </div>
        <div class="work-grid">
          {
            longVideos.map((video) => (
              <div class="work-item aspect-video" data-game={video.game}>
                <iframe
                  src={`https://www.youtube.com/embed/${video.id}?rel=0`}
                  title={video.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowFullScreen
                />
              </div>
            ))
          }
        </div>
      </div>

      <!-- ── Shorts (YouTube) ── -->
      <div class="work-panel" data-panel="shorts" hidden>
        <div class="work-filters" role="group" aria-label="Filtrar shorts por juego">
          {
            filters.shorts.map((f, i) => (
              <button type="button" class="work-filter" data-filter={f} aria-pressed="false">
                <span class="work-filter-number">{String(i + 1).padStart(2, "0")}</span>
                {filterLabels[f]}
              </button>
            ))
          }
        </div>
        <YouTubeShorts shorts={shorts} />
      </div>

      <!-- ── Miniaturas ── -->
      <div class="work-panel" data-panel="thumbs" hidden>
        <div class="work-filters" role="group" aria-label="Filtrar miniaturas por juego">
          {
            filters.thumbs.map((f, i) => (
              <button type="button" class="work-filter" data-filter={f} aria-pressed="false">
                <span class="work-filter-number">{String(i + 1).padStart(2, "0")}</span>
                {filterLabels[f]}
              </button>
            ))
          }
        </div>
        <div class="thumb-grid">
          {
            thumbs.map((thumb) => (
              <div
                class="thumb-item"
                data-game={thumb.game}
                data-thumb-src={thumb.src}
                tabindex="0"
              >
                <img
                  src={thumb.src}
                  alt={thumb.title}
                  width="1040"
                  height="585"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class="block w-full h-full"
                  style="aspect-ratio:16/9;object-fit:cover"
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Modal Preview -->
<div
  class="modal-overlay"
  id="thumbnail-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Vista previa de miniatura"
>
  <div class="modal-content">
    <img id="modal-image" src="" alt="" draggable="false" />
  </div>
</div>

<script>
  const tabs = document.querySelectorAll(".work-tab");
  const panels = document.querySelectorAll(".work-panel");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        t.classList.toggle("is-active", t === tab);
        t.setAttribute("aria-selected", t === tab ? "true" : "false");
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== tab.dataset.tab;
      });
    });
  });

  const thumbnails = document.querySelectorAll(".thumb-item");

  let visibleThumbs = Array.from(thumbnails);

  function refreshVisible() {
    visibleThumbs = Array.from(thumbnails).filter((t) => !t.hidden);
    if (currentIndex >= visibleThumbs.length) {
      currentIndex = Math.max(0, visibleThumbs.length - 1);
    }
  }

  const filterGroups = document.querySelectorAll(".work-filters");
  filterGroups.forEach((group) => {
    const panel = group.closest(".work-panel");
    const items = panel ? panel.querySelectorAll("[data-game]") : [];
    const filters = group.querySelectorAll(".work-filter");

    const applyFilter = () => {
      const active = group.querySelector(".work-filter.is-active");
      const activeFilter = active ? active.dataset.filter : null;
      items.forEach((item) => {
        item.hidden = activeFilter !== null && item.dataset.game !== activeFilter;
      });
      refreshVisible();
    };

    filters.forEach((btn) => {
      btn.addEventListener("click", () => {
        const wasPressed = btn.getAttribute("aria-pressed") === "true";
        filters.forEach((b) => {
          b.classList.remove("is-active");
          b.setAttribute("aria-pressed", "false");
        });
        if (!wasPressed) {
          btn.classList.add("is-active");
          btn.setAttribute("aria-pressed", "true");
        }
        applyFilter();
      });
    });
  });
  const modal = document.getElementById("thumbnail-modal");
  const modalImage = document.getElementById("modal-image");

  let currentIndex = 0;

  const lockScroll = (locked) => {
    const root = document.documentElement;
    if (locked) {
      const width = window.innerWidth - root.clientWidth;
      document.body.style.paddingRight = width ? `${width}px` : "";
      document.body.style.overflow = "hidden";
    } else {
      document.body.style.paddingRight = "";
      document.body.style.overflow = "";
    }
  };

  function openModal(index) {
    const item = visibleThumbs[index];
    if (!item) return;
    currentIndex = index;
    const img = item.querySelector("img");
    modalImage.src = item.dataset.thumbSrc;
    modalImage.alt = img ? img.alt : "Miniatura";
    modalImage.hidden = false;
    modal.classList.add("active");
    lockScroll(true);
  }

  function closeModal() {
    modal.classList.remove("active");
    modalImage.hidden = true;
    lockScroll(false);
  }

  function navigate(direction) {
    if (!visibleThumbs.length) return;
    currentIndex =
      (currentIndex + direction + visibleThumbs.length) % visibleThumbs.length;
    openModal(currentIndex);
  }

  thumbnails.forEach((thumb) => {
    thumb.addEventListener("click", () => {
      const idx = visibleThumbs.indexOf(thumb);
      openModal(idx);
    });
    thumb.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        const idx = visibleThumbs.indexOf(thumb);
        openModal(idx);
      }
    });
  });

  modal.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (!modal.classList.contains("active")) return;
    if (e.key === "Escape") closeModal();
    if (e.key === "ArrowLeft") navigate(-1);
    if (e.key === "ArrowRight") navigate(1);
  });
</script>

<style>
  /* ════════════════════════════════════════
     Section
     ════════════════════════════════════════ */
  .work {
    padding: 6rem 0;
  }

  /* ════════════════════════════════════════
     Subtítulos
     ════════════════════════════════════════ */
  .work-subtitle {
    margin: 3rem 0 1.5rem;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: rgb(255 255 255 / 0.85);
    text-align: center;
  }

  .work-subtitle:first-of-type {
    margin-top: 2rem;
  }

  /* ════════════════════════════════════════
     Tabs — strip segmentado editorial
     ════════════════════════════════════════ */
  .work-tabs {
    display: flex;
    justify-content: center;
    width: fit-content;
    margin: 2rem auto 2.5rem;
    border: 1px solid rgb(255 255 255 / 0.2);
  }

  .work-tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.25rem;
    border: 0;
    border-right: 1px solid rgb(255 255 255 / 0.15);
    background: transparent;
    color: rgb(255 255 255 / 0.55);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .work-tab:last-child {
    border-right: 0;
  }

  .work-tab:hover {
    color: #fff;
  }

  .work-tab.is-active {
    background: #fafafa;
    color: #0a0a0a;
  }

  .work-panel[hidden] {
    display: none;
  }

  /* ════════════════════════════════════════
     Filtros por juego — índice numerado
     ════════════════════════════════════════ */
  .work-filters {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2rem;
  }

  .work-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    margin: -1px 0 0 -1px;
    background: transparent;
    color: rgb(255 255 255 / 0.6);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .work-filter-number {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.4;
  }

  .work-filter:hover {
    color: #fff;
  }

  .work-filter.is-active {
    background: #fafafa;
    color: #0a0a0a;
  }

  .work-filter.is-active .work-filter-number {
    opacity: 1;
  }

  .work-tab:focus-visible,
  .work-filter:focus-visible {
    outline: 2px solid #fafafa;
    outline-offset: -2px;
  }

  /* ════════════════════════════════════════
     Videos largos — grid responsivo
     ════════════════════════════════════════ */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .work-item {
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background-color: #000;
  }

  .work-item iframe {
    width: 100%;
    height: 100%;
    display: block;
    border: 0;
  }

  .work-item[hidden] {
    display: none;
  }

  /* ════════════════════════════════════════
     Miniaturas — 16:9
     ════════════════════════════════════════ */
  .thumb-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }

  .thumb-item {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    background-color: #000;
    cursor: pointer;
    outline: none;
    transition: border-color 0.3s ease;
  }

  .thumb-item[hidden] {
    display: none;
  }

  .thumb-item:focus-visible {
    outline: 2px solid #fafafa;
    outline-offset: -2px;
  }

  .thumb-item img {
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .thumb-item:hover img,
  .thumb-item:focus-visible img {
    transform: scale(1.07);
  }

  /* ════════════════════════════════════════
     Responsive
     ════════════════════════════════════════ */
  @media (min-width: 640px) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .work-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 767px) {
    .work {
      padding: 4rem 0;
    }
  }

  @media (max-width: 639px) {
    .work-tabs {
      flex-direction: column;
      width: 100%;
    }

    .work-tab {
      border-right: 0;
      border-bottom: 1px solid rgb(255 255 255 / 0.15);
    }

    .work-tab:last-child {
      border-bottom: 0;
    }
  }

  /* ════════════════════════════════════════
     Modal Preview
     ════════════════════════════════════════ */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      visibility 0.3s ease;
    padding: 1rem;
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-content {
    position: relative;
    max-width: 720px;
    width: 100%;
    max-height: 90vh;
    transform: scale(0.9);
    transition: transform 0.3s ease;
  }

  .modal-overlay.active .modal-content {
    transform: scale(1);
  }

  .modal-content img {
    width: 100%;
    height: auto;
    max-height: 90vh;
    object-fit: contain;
    border-radius: 0.5rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }
</style>
