---
const services = [
  {
    id: 'miniaturas',
    title: 'Edición de miniaturas',
    description: [
      'Una buena miniatura compra a los usuarios antes de que lean el título del video.',
      'Diseño miniaturas con una creatividad única y una infinidad de estilos entre los que puedes elegir el que más se adapte a tu imagen. También puedo inspirarme en el estilo de tu creador de contenido favorito.',
    ],
    media: {
      type: 'beforeAfter',
      before: '/thumbnail-after.webp',
      after: '/thumbnail-before.webp',
    },
  },
];
---

<section id="servicios" class="services">
  <div class="container-portfolio">
    <h2 class="section-title">Servicios</h2>

    <div class="services-nav" role="group" aria-label="Servicios">
        {
          services.map((service, index) => (
            <button
              type="button"
              class:list={['service-tab', { active: index === 0 }]}
              data-service={service.id}
              aria-pressed={index === 0}
            >
              <span class="service-number">{String(index + 1).padStart(2, '0')}</span>
              {service.title}
            </button>
          ))
        }
      </div>

      <div class="services-content">
        {
          services.map((service, index) => (
            <article
              id={`service-panel-${service.id}`}
              class:list={['service-panel', { active: index === 0 }]}
              data-panel={service.id}
            >
              <h3 class="service-title">{service.title}</h3>

              {service.description.map((paragraph) => (
                <p class="service-description">{paragraph}</p>
              ))}

              {
                service.media?.type === 'beforeAfter' && (
                  <div
                    class="compare"
                    style="--pos: 0%"
                    role="slider"
                    aria-label="Comparación antes y después"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="0"
                    tabindex="0"
                  >
                    <img
                      class="compare-image"
                      src={service.media.before}
                      alt="Miniatura antes de la edición"
                      width="1280"
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      class="compare-image compare-image--after"
                      src={service.media.after}
                      alt="Miniatura después de la edición"
                      width="1280"
                      height="720"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="compare-handle" aria-hidden="true">
                      <div class="compare-grip">◄ ►</div>
                    </div>
                  </div>
                )
              }
            </article>
          ))
        }
    </div>
  </div>
</section>

<script>
  function initServices() {
    const section = document.getElementById('servicios');
    if (!section) return;

    const tabs = section.querySelectorAll('[data-service]');
    const panels = section.querySelectorAll('[data-panel]');

    const activate = (id) => {
      tabs.forEach((tab) => {
        const isActive = tab.dataset.service === id;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-pressed', String(isActive));
      });
      panels.forEach((panel) => {
        panel.classList.toggle('active', panel.dataset.panel === id);
      });
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => activate(tab.dataset.service));
    });

    const compare = section.querySelector('[role="slider"]');
    if (!compare) return;

    const rect = () => compare.getBoundingClientRect();
    const apply = (pct) => {
      const clamped = Math.min(100, Math.max(0, pct));
      compare.style.setProperty('--pos', `${clamped}%`);
      compare.setAttribute('aria-valuenow', String(Math.round(clamped)));
    };
    const fromPointer = (clientX) => {
      apply(((clientX - rect().left) / rect().width) * 100);
    };

    let dragging = false;

    compare.addEventListener('pointerdown', (event) => {
      dragging = true;
      compare.setPointerCapture(event.pointerId);
      fromPointer(event.clientX);
    });

    compare.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      fromPointer(event.clientX);
    });

    ['pointerup', 'pointercancel'].forEach((type) => {
      compare.addEventListener(type, () => {
        dragging = false;
      });
    });

    compare.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const step = 4;
      const current = parseFloat(compare.style.getPropertyValue('--pos')) || 50;
      const next = event.key === 'ArrowLeft' ? current - step : current + step;
      apply(next);
    });
  }

  document.addEventListener('DOMContentLoaded', initServices);
</script>

<style>
  .services {
    padding: 6rem 0;
  }

  .services-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .service-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgb(255 255 255 / 0.18);
    margin: -1px 0 0 -1px;
    background: transparent;
    color: rgb(255 255 255 / 0.6);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .service-tab:hover {
    color: #fff;
  }

  .service-tab.active {
    background: #fafafa;
    color: #0a0a0a;
  }

  .service-number {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.4;
  }

  .service-tab.active .service-number {
    opacity: 1;
  }

  .service-tab:focus-visible {
    outline: 2px solid #fafafa;
    outline-offset: -2px;
  }

  .service-panel {
    display: none;
  }

  .service-panel.active {
    display: block;
    animation: panel-in 0.4s ease;
  }

  .service-title {
    margin-bottom: 1.25rem;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .service-description {
    margin-bottom: 1.5rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.7);
  }

  .compare {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    max-height: 400px;
    margin-inline: auto;
    background: #0a0a0a;
    cursor: ew-resize;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    outline: none;
  }

  .compare:focus-visible {
    outline: 2px solid rgb(255 255 255 / 0.5);
    outline-offset: 2px;
  }

  .compare-image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 400px;
    object-fit: contain;
    pointer-events: none;
  }

  .compare-image--after {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(0 0 0 var(--pos));
  }

  .compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    background: #ffffff;
    transform: translateX(-50%);
    box-shadow: 0 0 12px rgb(0 0 0 / 0.6);
    pointer-events: none;
  }

  .compare-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    background: #ffffff;
    color: #0a0a0a;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.5);
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .services {
      padding: 4rem 0;
    }
  }
</style>