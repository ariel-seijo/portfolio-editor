---
const services = [
  {
    id: 'clip-farm',
    title: 'Granja de clips',
    description: 'Reviso el <span class="desc-highlight">VOD de tu stream</span> y extraigo todos los clips con potencial para <span class="desc-highlight">formato reel</span>. Al final, te entrego una carpeta con todos los <span class="desc-highlight">clips recortados</span>.',
  },
  {
    id: 'video-edit',
    title: 'Edición de video',
    description: 'Convierto tu material en contenido atractivo para YouTube y plataformas de formato corto. <span class="desc-highlight">Edición dinámica</span>, <span class="desc-highlight">subtítulos</span>, <span class="desc-highlight">sound design</span>, <span class="desc-highlight">transiciones</span> y <span class="desc-highlight">efectos visuales</span> adaptados a tu estilo.',
  },
  {
    id: 'image-edit',
    title: 'Edición de imagen',
    description: '<span class="desc-highlight">Miniaturas</span>, <span class="desc-highlight">banners</span> y <span class="desc-highlight">piezas gráficas</span> diseñadas para destacar tu contenido.',
  },
];
---

<section id="servicios" class="services">
  <div class="container-portfolio">
  <h2 class="section-title">Servicios</h2>

    <div class="services-grid">
      <!-- Columna 1: Servicios -->
      <div class="services-list">
        {services.map((service, index) => (
          <button
            class:list={['service-card', { active: index === 0 }]}
            data-service={service.id}
          >
            <span class="service-number">0{index + 1}</span>
            <span class="service-name">{service.title}</span>
          </button>
        ))}
      </div>

      <!-- Columna 2: Descripción -->
      <div class="services-description">
        {services.map((service, index) => (
          <div
            class:list={['description-content', { active: index === 0 }]}
            data-description={service.id}
          >
            <p set:html={service.description}></p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initServices() {
    const cards = document.querySelectorAll('.service-card');
    const descriptions = document.querySelectorAll('.description-content');

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const serviceId = card.getAttribute('data-service');

        // Update cards
        cards.forEach((c) => c.classList.remove('active'));
        card.classList.add('active');

        // Update descriptions
        descriptions.forEach((d) => {
          d.classList.toggle('active', d.getAttribute('data-description') === serviceId);
        });
      });
    });
  }

  // Run on page load
  document.addEventListener('DOMContentLoaded', initServices);

  // Run on View Transitions navigation
  document.addEventListener('astro:after-swap', initServices);
</script>

<style>
  .services {
    padding: 6rem 0;
    text-align: center;
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    max-width: 72rem;
    margin-inline: auto;
  }

  /* Columna 1: Lista de servicios */
  .services-list {
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    width: 100%;
  }

  .service-card {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 1.5rem;
    background: transparent;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 0;
    margin-bottom: -1px;
    color: rgb(255 255 255 / 0.5);
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-align: left;
    width: 100%;
    font-family: inherit;
    z-index: 1;
  }

  .service-card.active {
    z-index: 2;
  }

  .service-card:hover {
    border-color: rgb(255 255 255 / 0.15);
    color: rgb(255 255 255 / 0.7);
  }

  .service-card.active {
    border-color: #fafafa;
    background: rgb(255 255 255 / 0.08);
    color: white;
  }

  .service-number {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    opacity: 0.4;
  }

  .service-card.active .service-number {
    color: #ffffff;
    opacity: 1;
  }

  .service-name {
    font-size: 1rem;
    font-weight: 500;
  }

  /* Columna 2: Descripción */
  .services-description {
    position: relative;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .description-content {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0.3s;
  }

  .description-content.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .description-content p {
    font-size: 1.25rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.65);
    max-width: 40rem;
    margin-inline: 0;
    text-align: left;
  }

  .description-content .desc-highlight {
    color: #ffffff;
    font-weight: 700;
  }

  /* ════════════════════════════════════════
     Responsive — Desktop
     ════════════════════════════════════════ */
  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: 280px 1fr;
      gap: 3rem;
      align-items: start;
    }

    .service-card {
      padding: 1.5rem 1.75rem;
      justify-content: flex-start;
    }

    .service-name {
      font-size: 1.125rem;
    }

    .services-list {
      margin-inline: 0;
    }
  }

  /* ════════════════════════════════════════
     Responsive — Mobile
     ════════════════════════════════════════ */
  @media (max-width: 767px) {
    .services {
      padding: 4rem 0;
    }

    .services-description {
      order: -1;
      min-height: auto;
      padding-bottom: 2rem;
    }

    .description-content {
      position: relative;
    }

    .description-content:not(.active) {
      display: none;
    }
  }
</style>
