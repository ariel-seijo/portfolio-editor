---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import ClientCard from './ClientCard.astro';

const FALLBACK_HANDLES = [
  'cesaroxx3561',
  'deadlymark5740',
  'hilyra',
  'charlyscott',
  'foxyadc',
  'wanderingnovagaming',
  'hazukytv',
  'neorodriguezmx9',
  'duxtertv',
  'zaxrevengeance',
];

interface CachedClient {
  handle: string;
  title: string;
  channelUrl: string;
  file: string;
}

const CLIENTS_DIR = join(process.cwd(), 'public', 'clients');

let cached: CachedClient[] = [];
try {
  cached = JSON.parse(readFileSync(join(CLIENTS_DIR, '_data.json'), 'utf-8')) as CachedClient[];
} catch {
  cached = [];
}

const byHandle = new Map(cached.map((c) => [c.handle, c]));

const clients = FALLBACK_HANDLES.map((handle) => {
  const entry = byHandle.get(handle);
  const file = `${handle}.jpg`;
  const photoAvailable = existsSync(join(CLIENTS_DIR, file));

  return {
    name: entry?.title ?? `@${handle}`,
    handle,
    photoUrl: photoAvailable ? `/clients/${file}` : '',
    channelUrl: entry?.channelUrl ?? `https://www.youtube.com/@${handle}`,
  };
});
---

<section id="clientes" class="clients">
  <div class="container-portfolio">
    <div class="clients-heading">
      <span class="clients-kicker">Colaboraciones</span>
      <h2 class="section-title">Clientes</h2>
      <p class="clients-subtitle">
        Creadores que confían en mí para llevar su contenido al siguiente nivel.
      </p>
    </div>

    <div class="clients-grid">
      {
        clients.map((client) => (
          <ClientCard
            name={client.name}
            handle={client.handle}
            photoUrl={client.photoUrl}
            channelUrl={client.channelUrl}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .clients {
    position: relative;
    padding: 7rem 0 6rem;
    overflow: hidden;
  }

  .clients::before {
    content: '';
    position: absolute;
    top: -180px;
    left: 50%;
    transform: translateX(-50%);
    width: 720px;
    height: 360px;
    background: radial-gradient(ellipse, rgb(255 255 255 / 0.06), transparent 70%);
    pointer-events: none;
  }

  .clients-heading {
    margin-bottom: 3.5rem;
    text-align: center;
  }

  .clients-kicker {
    display: inline-block;
    margin-bottom: 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.45);
  }

  .clients-subtitle {
    max-width: 34rem;
    margin: -1rem auto 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.5);
  }

  .clients-grid {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 2.25rem;
    column-gap: 1rem;
    justify-content: center;
  }

  @media (min-width: 560px) {
    .clients-grid {
      grid-template-columns: repeat(4, minmax(100px, 170px));
    }
  }

  @media (min-width: 820px) {
    .clients-grid {
      grid-template-columns: repeat(5, minmax(120px, 170px));
    }
  }

  @media (min-width: 1024px) {
    .clients-grid {
      grid-template-columns: repeat(6, minmax(120px, 170px));
    }
  }

  @media (max-width: 767px) {
    .clients {
      padding: 4.5rem 0 4rem;
    }

    .clients-heading {
      margin-bottom: 2.5rem;
    }

    .clients-grid {
      row-gap: 1.75rem;
    }
  }
</style>