---
import type { Project } from '../types';
import CloudinaryImage from './CloudinaryImage.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<a href={`/projects/${project.id}`} class="card-project group block">
  <div class="relative aspect-video overflow-hidden">
    <CloudinaryImage
      publicId={project.thumbnail}
      alt={project.title}
      width={800}
      height={450}
      class="h-full w-full transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
      <div class="absolute bottom-4 left-4 right-4">
        <div class="flex flex-wrap gap-2">
          {project.tags.slice(0, 3).map((tag) => (
            <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-medium backdrop-blur-sm">
              {tag}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
  <div class="p-4">
    <h3 class="mb-1 text-lg font-semibold">{project.title}</h3>
    <p class="line-clamp-2 text-sm text-white/60">{project.description}</p>
  </div>
</a>
