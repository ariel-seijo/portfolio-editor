---
interface Props {
  name: string;
  handle: string;
  photoUrl: string;
  channelUrl: string;
  verified?: boolean;
}

const {
  name,
  handle,
  photoUrl,
  channelUrl,
  verified = true,
} = Astro.props;
---

<a
  href={channelUrl}
  class="client-card"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Canal de ${name} en YouTube`}
>
  <div class="client-avatar-wrap">
    <div class="client-avatar">
      {photoUrl ? (
        <img
          src={photoUrl}
          alt={`Foto de perfil de ${name}`}
          loading="lazy"
          decoding="async"
          width="200"
          height="200"
        />
      ) : (
        <div class="client-avatar-fallback" aria-hidden="true">
          {handle.charAt(0).toUpperCase()}
        </div>
      )}
    </div>
    <span class="client-avatar-glow" aria-hidden="true"></span>
  </div>

  <div class="client-name-row">
    <span class="client-name">{name}</span>
    {verified && (
      <span class="verified-badge" title="Verificado" aria-label="Verificado">
        <svg
          viewBox="0 0 24 24"
          width="12"
          height="12"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M9.55 17.7 4.9 13.05l1.45-1.45 3.2 3.2 8.1-8.1 1.45 1.45-8.55 8.55z" />
        </svg>
      </span>
    )}
  </div>

  <span class="client-handle">@{handle}</span>
</a>

<style>
  .client-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 0;
    text-align: center;
    text-decoration: none;
    transition: transform 0.35s ease;
  }

  .client-card:hover {
    transform: translateY(2px);
  }

  .client-avatar-wrap {
    position: relative;
    width: 110px;
    height: 110px;
  }

  .client-avatar {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }

  .client-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.9);
    transition:
      filter 0.4s ease,
      transform 0.4s ease;
  }

  .client-card:hover .client-avatar img {
    filter: saturate(1.15);
    transform: scale(1.05);
  }

  .client-avatar-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 2.5rem;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(135deg, #1d9bf0, #a855f7);
  }

  .client-avatar-glow {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(
      from 180deg,
      rgb(255 255 255 / 0.35),
      rgb(255 255 255 / 0.05),
      rgb(255 255 255 / 0.35)
    );
    opacity: 0.5;
    transition: opacity 0.4s ease;
    mask:
      radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    -webkit-mask:
      radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
  }

  .client-card:hover .client-avatar-glow {
    opacity: 1;
  }

  .client-name-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 0;
  }

  .client-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: rgb(255 255 255 / 0.92);
    line-height: 1.3;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .client-card:hover .client-name {
    color: #ffffff;
  }

  .verified-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: #1d9bf0;
    color: #ffffff;
  }

  .client-handle {
    font-size: 0.82rem;
    color: rgb(255 255 255 / 0.4);
    letter-spacing: 0.01em;
    transition: color 0.3s ease;
  }

  .client-card:hover .client-handle {
    color: rgb(255 255 255 / 0.65);
  }
</style>