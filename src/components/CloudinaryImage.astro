---
import { getCloudinaryUrl } from '../lib/cloudinary';

interface Props {
  publicId: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  publicId,
  alt,
  width = 800,
  height = 600,
  class: className = '',
  loading = 'lazy',
} = Astro.props;

const src = getCloudinaryUrl(publicId, { width, height, crop: 'fill' });
const srcSet = [
  getCloudinaryUrl(publicId, { width: width * 0.5, height: height * 0.5, crop: 'fill' }) + ' 480w',
  getCloudinaryUrl(publicId, { width, height, crop: 'fill' }) + ' 800w',
  getCloudinaryUrl(publicId, { width: width * 1.5, height: height * 1.5, crop: 'fill' }) + ' 1200w',
].join(', ');
---

<img
  src={src}
  srcset={srcSet}
  alt={alt}
  width={width}
  height={height}
  loading={loading}
  decoding="async"
  class:list={['object-cover', className]}
/>
