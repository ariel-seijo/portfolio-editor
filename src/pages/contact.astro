---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto — Portfolio">
  <section class="py-20">
    <div class="container-portfolio">
      <div class="mx-auto max-w-2xl">
        <h1 class="section-title">Contacto</h1>
        <p class="mb-12 text-lg text-white/60">
          ¿Tienes un proyecto en mente? Me encantaría escuchar tu idea.
        </p>

        <form class="space-y-6">
          <div>
            <label for="name" class="mb-2 block text-sm font-medium text-white/70">Nombre</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-white/30 transition-colors focus:border-white focus:outline-none focus:ring-1 focus:ring-white"
            />
          </div>

          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-white/70">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-white/30 transition-colors focus:border-white focus:outline-none focus:ring-1 focus:ring-white"
            />
          </div>

          <div>
            <label for="project-type" class="mb-2 block text-sm font-medium text-white/70">
              Tipo de proyecto
            </label>
            <select
              id="project-type"
              name="project-type"
              class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white transition-colors focus:border-white focus:outline-none focus:ring-1 focus:ring-white"
            >
              <option value="video">Edición de Video</option>
              <option value="image">Edición de Imagen</option>
              <option value="both">Video + Imagen</option>
              <option value="other">Otro</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-2 block text-sm font-medium text-white/70">Mensaje</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full resize-none rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-white placeholder-white/30 transition-colors focus:border-white focus:outline-none focus:ring-1 focus:ring-white"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full">Enviar mensaje</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
