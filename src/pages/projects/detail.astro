---
import BaseLayout from '../../layouts/BaseLayout.astro';

// TODO: Implementar rutas dinámicas con getStaticPaths
// Para ahora es una página estática de ejemplo
---

<BaseLayout title="Detalle del Proyecto — Portfolio">
  <section class="py-20">
    <div class="container-portfolio">
      <a href="/projects" class="mb-8 inline-flex items-center gap-2 text-sm text-white/60 transition-colors hover:text-white">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Volver a proyectos
      </a>

      <article class="mx-auto max-w-4xl">
        <h1 class="mb-4 text-4xl font-bold">Nombre del Proyecto</h1>
        <p class="mb-8 text-lg text-white/60">
          Descripción detallada del proyecto, el proceso creativo y los resultados obtenidos.
        </p>

        <!-- Galería -->
        <div class="mb-12 grid gap-4 sm:grid-cols-2">
          <div class="aspect-video rounded-xl border border-white/10 bg-white/5"></div>
          <div class="aspect-video rounded-xl border border-white/10 bg-white/5"></div>
        </div>

        <!-- Detalles -->
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <h3 class="mb-2 text-sm font-medium text-white/40">Herramientas</h3>
            <p>DaVinci Resolve, After Effects, Photoshop</p>
          </div>
          <div>
            <h3 class="mb-2 text-sm font-medium text-white/40">Categoría</h3>
            <p>Edición de Video</p>
          </div>
          <div>
            <h3 class="mb-2 text-sm font-medium text-white/40">Fecha</h3>
            <p>Enero 2024</p>
          </div>
          <div>
            <h3 class="mb-2 text-sm font-medium text-white/40">Cliente</h3>
            <p>Nombre del Cliente</p>
          </div>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
